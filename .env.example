# FastAPI 应用名称，会显示在 OpenAPI 文档和监控信息中。
APP_NAME=Survey Pal API

# 当前应用版本，会显示在 OpenAPI 文档中；发布新版本时同步更新。
APP_VERSION=0.1.0

# 运行环境，可选值：local、test、staging、production。
ENVIRONMENT=local

# 是否开启 FastAPI 调试模式；生产环境必须设置为 false。
DEBUG=false

# 应用日志级别，常用值：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# PostgreSQL 异步连接地址，格式为：postgresql+asyncpg://用户名:密码@主机:端口/数据库名。
DATABASE_URL=postgresql+asyncpg://survey_pal:survey_pal@localhost:5432/survey_pal

# 每个 API 进程常驻的数据库连接池大小。
DATABASE_POOL_SIZE=10

# 连接池耗尽时允许临时创建的额外数据库连接数。
DATABASE_MAX_OVERFLOW=20

# 等待获取数据库连接的最长时间，单位为秒；超时后请求会失败。
DATABASE_POOL_TIMEOUT_SECONDS=5

# Redis 缓存实例地址，用于缓存、会话状态、限流和在线状态等可重建数据。
REDIS_CACHE_URL=redis://localhost:6379/0

# Celery 消息代理地址，用于异步任务队列；生产环境必须与缓存使用不同 Redis 实例。
REDIS_BROKER_URL=redis://localhost:6380/0

# Redis 建立连接和执行命令的超时时间，单位为秒。
REDIS_SOCKET_TIMEOUT_SECONDS=2

# JWT 签名密钥；生产环境必须替换为足够长的随机密钥，并通过密钥管理服务注入。
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes

# JWT 签名算法，当前默认使用 HS256。
JWT_ALGORITHM=HS256

# Access Token 有效期，单位为分钟；用于普通 API 访问认证。
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh Token 有效期，单位为天；用于轮换并签发新的 Token。
REFRESH_TOKEN_EXPIRE_DAYS=30

# 允许跨域访问 API 的前端来源，可填写 JSON 数组或英文逗号分隔列表；生产环境不要使用通配符。
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Sentry 项目 DSN，用于异常追踪；留空表示不启用 Sentry。
SENTRY_DSN=
